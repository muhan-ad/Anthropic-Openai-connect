# 复制本文件为 .env 并按需修改，例如：
#   Windows PowerShell:  Copy-Item .env.example .env

# 本服务监听端口（Claude Code 的 ANTHROPIC_BASE_URL 指向它）
PORT=18880

# 监听地址（安全）：保持 127.0.0.1 仅本机可访问；切勿改成 0.0.0.0，除非上游无敏感权限
HOST=127.0.0.1

# 上游 OpenAI 兼容端点（默认阿里云百炼 compatible-mode）
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 上游 API Key（阿里云百炼控制台创建，sk- 开头）
UPSTREAM_API_KEY=sk-your-dashscope-api-key

# 默认模型：请求未带模型或映射表无匹配时使用
DEFAULT_MODEL=deepseek-v4-flash-0731

# 模型映射（可选）：Claude Code 配置的模型名=上游模型名，逗号分隔多个
# 例：把 Claude Code 里的 claude-sonnet 映射到百炼的 deepseek-v4-flash-0731
MODEL_MAP=claude-haiku=deepseek-v4-flash-0731,claude-sonnet=deepseek-v4-flash-0731,claude-opus=deepseek-v4-pro

# 本地鉴权 Token（强烈建议设置）：设置后请求的 x-api-key/Authorization 必须等于该值。
# 与 Claude Code settings.json 的 ANTHROPIC_AUTH_TOKEN 保持一致；留空则本服务不校验（仅本机监听时风险较低）
LOCAL_AUTH_TOKEN=local-dev-token
